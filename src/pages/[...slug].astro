---
import { getCollection, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import docsConfig from '../../.generated-docs/docs.json';
import meta from '../../.generated-docs/site-meta.json';
import { base, pagePath, repoUrl, localeOf, localizedSlug } from '../../scripts/site.mjs';

import { labels } from '../../scripts/i18n.mjs';

export async function getStaticPaths() {
  const docs = await getCollection('docs');
  return docs.map(doc => ({ params: { slug: doc.id === 'index' ? undefined : doc.id.replace(/\/index$/, '') }, props: { doc, docs } }));
}
const { doc, docs } = Astro.props;
const { Content, headings } = await render(doc);
const pageId = meta.sources[doc.id] ? doc.id : `${doc.id}/index`;
const titleMap = Object.fromEntries(docs.flatMap(d => [[d.id, d.data.title], [`${d.id}/index`, d.data.title]]));
const locale = localeOf(pageId);
const t = labels[locale];
const groups = docsConfig.navigation.languages.find(l => l.language === (locale === 'en' ? 'en' : 'cn')).groups;
const pages = groups.flatMap(group => group.pages);
const currentIndex = pages.indexOf(pageId);
const prev = pages[currentIndex - 1];
const next = pages[currentIndex + 1];
const groupName = groups.find(g => g.pages.includes(pageId))?.group;
const isHome = localizedSlug(pageId, 'zh') === 'index';
const resourceCount = localizedSlug(pageId, 'zh').startsWith('resources/') ? (doc.body || '').split('\n').filter(line => /^- \[[^\]]+\]\(https?:/.test(line)).length : 0;
const source = meta.sources[pageId];
---
<Layout title={doc.data.title} description={doc.data.description} slug={pageId}>
  <div class="site-shell">
    <aside class="sidebar" id="site-navigation" aria-label={t.directory}>
      <nav>
        {groups.map(group => <section class="nav-group">
          <h2>{group.group}</h2>
          <ul>{group.pages.map(slug => <li><a href={`${base}${pagePath(slug)}`} aria-current={slug === pageId ? 'page' : undefined}>
            <span class="nav-dot" aria-hidden="true"></span><span>{titleMap[slug] || slug}</span>
          </a></li>)}</ul>
        </section>)}
      </nav>
      <a class="sidebar-source" href={repoUrl} target="_blank" rel="noopener noreferrer">{t.contribute}</a>
    </aside>
    <main id="main" class:list={{ 'home-page': isHome }}>
      <article data-pagefind-body>
        <header class="page-heading">
          <div class="eyebrow">{isHome ? 'AN OPEN MAP OF AI & CHIP DESIGN' : groupName}{resourceCount > 0 && <span class="count">{resourceCount} {t.resources}</span>}</div>
          <h1 data-pagefind-meta="title">{doc.data.title}</h1>
          {!isHome && <p class="page-description">{doc.data.description}</p>}
          {isHome && <div class="home-stats" data-pagefind-ignore><span><strong>{meta.resources}</strong> {t.resources}</span><span><strong>{meta.tutorials}</strong> {t.tutorials}</span><a href={`${base}${pagePath(localizedSlug('environments/index', locale))}`}><strong>{meta.environments}</strong> {t.environments} ↗</a></div>}
        </header>
        <div class="prose"><Content /></div>
      </article>
      <footer class="page-footer" data-pagefind-ignore>
        <div class="source-links"><a href={`${repoUrl}/edit/main/${source}`} target="_blank" rel="noopener noreferrer">{t.edit}</a><a href={`${base}source/${pageId}.md`}>Markdown</a></div>
        <nav class="page-pagination" aria-label={t.adjacent}>
          {prev ? <a href={`${base}${pagePath(prev)}`}><small>{t.previous}</small><span>{titleMap[prev]}</span></a> : <span />}
          {next && <a href={`${base}${pagePath(next)}`}><small>{t.next}</small><span>{titleMap[next]}</span></a>}
        </nav>
        <p class="site-note">Awesome AI4Chip <span>{t.note}</span></p>
      </footer>
    </main>
    <aside class="table-of-contents" aria-label={t.toc}>
      {headings.length > 0 && <><h2>{t.toc}</h2><nav>{headings.filter(h => h.depth < 4).map(h => <a class:list={{ nested: h.depth === 3 }} href={`#${h.slug}`}>{h.text}</a>)}</nav></>}
    </aside>
  </div>
</Layout>
