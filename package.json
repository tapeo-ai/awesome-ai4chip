{
  "name": "awesome-ai4chip",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "node scripts/prepare-docs.mjs --check-latest && node scripts/check-content.mjs",
    "build": "astro build && pagefind --site dist && node scripts/check-site.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "test": "node --test scripts/*.test.mjs",
    "docs:sync": "node scripts/prepare-docs.mjs --sync-latest"
  },
  "dependencies": {
    "@astrojs/mdx": "4.3.14",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@mintlify/astro": "1.0.0",
    "astro": "5.18.2"
  },
  "devDependencies": {
    "@pagefind/default-ui": "1.5.2",
    "pagefind": "1.5.2"
  }
}
